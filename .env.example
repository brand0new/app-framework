# ── Google Cloud ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Vertex AI Agent Engine ────────────────────────────────────────────────────
AGENT_ENGINE_RESOURCE_NAME=projects/your-project/locations/us-central1/reasoningEngines/your-engine-id

# ── LLM Models ────────────────────────────────────────────────────────────────
# Primary orchestration model (cost-optimised)
PRIMARY_MODEL=gemini-2.5-flash
# Specialist/reasoning model (higher quality)
SPECIALIST_MODEL=gemini-2.5-pro

# ── BPMN Microservice ─────────────────────────────────────────────────────────
BPMN_SERVICE_URL=http://localhost:3001
BPMN_SERVICE_API_KEY=change-me

# ── Neo4j AuraDB ──────────────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# ── Confluent Cloud (Kafka) ───────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east1.gcp.confluent.cloud:9092
KAFKA_API_KEY=change-me
KAFKA_API_SECRET=change-me
KAFKA_TOPIC_AGENT_EVENTS=appygentic.agent.events
KAFKA_TOPIC_BILLING_EVENTS=appygentic.billing.events

# ── Stripe Billing ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me
STRIPE_METER_TASK_COMPLETED=meter_task_completed_id
STRIPE_METER_DELIVERABLE_ACCEPTED=meter_deliverable_accepted_id

# ── A2A Gateway ───────────────────────────────────────────────────────────────
A2A_BASE_URL=https://api.appygentic.io/a2a
A2A_GATEWAY_HOST=0.0.0.0
A2A_GATEWAY_PORT=8080

# ── OAuth2 / Auth ─────────────────────────────────────────────────────────────
OAUTH2_AUTHORIZATION_URL=https://auth.appygentic.io/oauth/authorize
OAUTH2_TOKEN_URL=https://auth.appygentic.io/oauth/token
API_KEY_HEADER=X-API-Key

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=appygentic
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.googleapis.com
OTEL_LOG_LEVEL=INFO

# ── MCP Skill Services ────────────────────────────────────────────────────────
MCP_APIGEE_URL=http://localhost:3100
MCP_APIM_URL=http://localhost:3101
MCP_NEO4J_URL=http://localhost:3102
MCP_CALENDAR_URL=http://localhost:3103
MCP_EMAIL_URL=http://localhost:3104
